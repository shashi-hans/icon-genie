# Template only — this file IS committed, so every value here must stay a
# placeholder. Put real values in .env or .env.local (both gitignored), and set
# the same names as Environment Variables in the Vercel project for deploys.
#
# server/lib/env.js reads .env.local then .env at startup, and never overrides a
# variable that is already set, so a deployment's own configuration always wins.

# Signs the session and guest cookies (HMAC-SHA256). Without it the server
# refuses to sign sessions in production, because an unsigned cookie would let
# anyone hand us role=admin. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The admin password, compared in constant time. Leave unset to disable admin
# login entirely (the API answers 503 and the gallery says so).
#
# This is ONE SHARED credential: no record of which person acted, and revoking
# access means rotating it for everyone. Fine for a private review queue, wrong
# past a couple of admins — the upgrade is an identity provider (GitHub OAuth
# fits, since an admin here already merges the icon PRs).
ADMIN_PASSWORD=

# --- Supabase (required) ------------------------------------------------------
# Supabase is the only storage driver. There is no in-memory fallback: without
# the two variables below the static gallery still serves, and every request that
# needs data fails. STORE_DRIVER is no longer needed — leave it unset, or set it
# to "supabase"; any other value is refused so an old deployment fails loudly
# rather than silently reading a database it did not ask for.
#
# Apply the migrations in supabase/migrations/ in order first; the driver assumes
# those tables, the record_visit function, and RLS being on.
#
# Keep the project in ap-south-1 (Mumbai). Submissions and guest history are
# personal data under the DPDP Act 2023, so where the database physically sits is
# a compliance decision, not a latency one.

# Project URL, e.g. https://<project-ref>.supabase.co — Settings > API. Not a
# secret; it is in every request the dashboard makes.
SUPABASE_URL=

# The service_role key, which BYPASSES row-level security by design. Treat it as
# a database password: server-side only, never in a page, a client bundle, or a
# log line. It is used because every table is reached through this project's own
# API, which does its own authorization — the review queue behind an admin
# session, history scoped to the caller's own guest id.
#
# Do NOT put the anon key here: the migration revokes its access on purpose, so
# the driver would read nothing.
SUPABASE_SERVICE_ROLE_KEY=

# --- Publishing approved icons ----------------------------------------------
# On approval the icon's centerline file is written to
# raw-svgs/<name>/<name>.centerline.svg, which is what `npm run build:icons`
# turns into a real package export.
#
# Locally that is a plain file write and needs nothing here. A deployed function
# cannot persist a file (read-only filesystem, rebuilt each deploy), so it uses
# the GitHub API instead and needs a token. Leave GITHUB_TOKEN unset and approval
# still works — the icon goes live in the gallery, and the admin page hands you
# the file to commit by hand.
#
# Approval is the only gate: the file is committed straight to GH_BASE, with no
# pull request to merge. Scope the token to this repo only, and to contents:write
# alone — no pull-request permission is needed.
GITHUB_TOKEN=

# Where to commit. Defaults shown.
# GH_REPO=shashi-hans/icon-genie
# GH_BASE=main

# --- The free "no setup" model -----------------------------------------------
# server/routes/ai-chat.js relays the gallery's free generations to an upstream
# chat-completions endpoint. The browser cannot call that upstream directly: it
# answers no CORS preflight, so the response is unreadable from a page.
#
# Both values have working defaults, so free mode needs nothing here. Set them to
# point at a different upstream, e.g. a locally running worker:
#   FREE_MODEL_BASE=http://127.0.0.1:8787/v1
# The URL must be https unless it is that kind of local test, and it is read only
# from the environment — never from the request — so the relay cannot be aimed at
# an internal address by a caller.
# FREE_MODEL_BASE=https://icon-genie-proxy.shashihans.workers.dev/v1
# FREE_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct

# Only if the upstream requires a key, sent as `Authorization: Bearer`. It stays
# server-side: the page never sees it, which is the reason the relay exists rather
# than the browser calling the model directly.
FREE_MODEL_KEY=
