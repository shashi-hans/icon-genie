{
  "name": "icon-genie",
  "version": "0.3.0",
  "description": "A tree-shakeable React icon library of 8469 icons, with a weight prop (thin, regular, fill, duotone). Artwork from Phosphor, Lucide, Feather, Tabler, Heroicons, Iconoir, Material Symbols and Ionicons.",
  "license": "MIT",
  "author": "Shashi Hans",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shashi-hans/icon-genie.git"
  },
  "homepage": "https://github.com/shashi-hans/icon-genie#readme",
  "bugs": {
    "url": "https://github.com/shashi-hans/icon-genie/issues"
  },
  "keywords": [
    "react",
    "icons",
    "svg",
    "icon-genie",
    "phosphor",
    "lucide",
    "tabler",
    "heroicons",
    "material-symbols",
    "icon-library",
    "typescript",
    "tree-shakeable"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSES",
    "CHANGELOG.md"
  ],
  "scripts": {
    "import:phosphor": "node scripts/import-phosphor.js",
    "draft:gap-icons": "node scripts/draft-gap-icons.js",
    "build:icons": "node scripts/optimize-svgs.js && node scripts/generate-components.js && node scripts/generate-index.js && node scripts/build-gallery.js",
    "build": "tsup",
    "build:all": "npm run build:icons && npm run build",
    "dev": "node scripts/dev-server.js",
    "dev:vercel": "vercel dev",
    "clean": "rimraf dist src/icons",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:all"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "rimraf": "^6.0.1",
    "sh-icon-genie": "^0.3.0",
    "svgo": "^3.3.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
